## --- Yapay Zeka Servisleri ---
# Groq Cloud Console'dan aldığınız API anahtarını buraya ekleyin
GROQ_API_KEY=gsk_your_actual_key_here

# --- Veritabanı Yapılandırması ---
# Örn: postgresql://user:password@localhost:5432/hayat_koprusu
DATABASE_URL=postgresql://user:password@localhost:5432/db_name

# --- Önbellek ve Kuyruk (Redis) ---
# Örn: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379

# --- Güvenlik Ayarları ---
# Üretim ortamında (production) mutlaka karmaşık bir string ile değiştirin
SECRET_KEY=32_karakterli_guclu_rastgele_anahtar_giriniz

# --- Erişim Kontrolü (CORS) ---
# İzin verilen domainleri aralarında boşluk bırakmadan, virgülle ayırarak yazın
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://hayatkoprusu.app

# --- Moderasyon ve Acil Durum Bildirimleri ---
# Uzmanlara gidecek e-posta adresi
EXPERT_NOTIFICATION_EMAIL=moderasyon@hayatkoprusu.app

# Uzmanlara gidecek SMS/WhatsApp bildirimi için telefon numarası
# Format: +90 ülke kodu ile birlikte, boşluksuz (Örn: +905XXXXXXXXX)
EXPERT_NOTIFICATION_PHONE=+905000000000
